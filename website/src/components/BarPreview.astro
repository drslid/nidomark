---
// The new bookmarks bar ("Emoji only"): quick access icons first, then the top-level folders, with what each holds.
import { CATEGORIES, GROUPS } from '@lib/taxonomy';
import MaterialIcon from './MaterialIcon.astro';

// Adult content and unreachable sites never go to the bar.
const groups = GROUPS.filter((g) => g.id !== 'adult' && g.id !== 'dead').map((g) => {
  const names = CATEGORIES.filter((c) => c.group === g.id && c.en !== g.en).map((c) => c.en);
  return { ...g, holds: names.slice(0, 3).join(', ') + (names.length > 3 ? '…' : '') };
});
---

<div class="bar-preview">
  <div class="bar" role="img" aria-label={`Bookmarks bar: icons of your most visited sites, then ${groups.length} folders shown as emoji: ${groups.map((g) => g.en).join(', ')}`}>
    <span class="bar-label" aria-hidden="true">Bookmarks bar</span>
    {[0, 1, 2, 3].map(() => <span class="bar-site" aria-hidden="true" />)}
    <span class="bar-gap" aria-hidden="true" />
    {groups.map((g) => <span class="bar-chip" aria-hidden="true">{g.emoji}</span>)}
  </div>
  <ul class="legend">
    <li>
      <span class="legend-emoji legend-quick" aria-hidden="true"><MaterialIcon name="bolt" /></span>
      <span class="legend-text">
        <span class="legend-name">Quick access</span>
        <span class="legend-holds">Your most visited sites, as icons only</span>
      </span>
    </li>
    {
      groups.map((g) => (
        <li>
          <span class="legend-emoji" aria-hidden="true">{g.emoji}</span>
          <span class="legend-text">
            <span class="legend-name">{g.en}</span>
            {g.holds && <span class="legend-holds">{g.holds}</span>}
          </span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .bar-preview {
    margin-top: 2rem;
    border: 1px solid var(--nm-outline-variant);
    border-radius: 16px;
    overflow: hidden;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.625rem 1.25rem;
    background: var(--nm-surface-low);
    border-bottom: 1px solid var(--nm-surface-high);
    overflow-x: auto;
  }
  .bar-label {
    margin-right: 0.75rem;
    color: var(--nm-on-surface-variant);
    font-size: 0.75rem;
    white-space: nowrap;
  }
  /* A site icon, without a real site's mark. */
  .bar-site {
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    margin: 0 0.5625rem;
    border-radius: 50%;
    background: var(--nm-surface-high);
    box-shadow: inset 0 0 0 1px var(--nm-outline-variant);
  }
  .bar-gap {
    flex: none;
    width: 0.25rem;
  }
  .bar-chip {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 2.25rem;
    height: 2rem;
    border-radius: 8px;
    font-size: 1.125rem;
    line-height: 1;
  }
  .legend {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14.5rem, 1fr));
    gap: 0.25rem 1.5rem;
    margin: 0;
    padding: 1rem 1.25rem 1.25rem;
    list-style: none;
  }
  .legend li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 0.5rem 0;
  }
  .legend-emoji {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 12px;
    background: var(--nm-secondary-container);
    font-size: 1.125rem;
    line-height: 1;
  }
  .legend-quick {
    background: var(--nm-primary-container);
    color: var(--nm-on-primary-container);
  }
  .legend-quick :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }
  .legend-text {
    display: grid;
    min-width: 0;
  }
  .legend-name {
    color: var(--nm-on-surface);
    font-weight: 500;
  }
  .legend-holds {
    color: var(--nm-on-surface-variant);
    font-size: 0.8125rem;
    line-height: 1.4;
  }
</style>
