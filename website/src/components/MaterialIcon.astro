---
// The extension's own Material Symbols Rounded icons (lib/ui/icons.ts), so the site and the app share one set.
import { ICONS } from '@lib/ui/icons';

interface Props {
  name: string;
  class?: string;
  label?: string;
}
const { name, class: className, label } = Astro.props;
const [viewBox, d] = ICONS[name] ?? ['0 0 24 24', ''];
---

<svg class={className} viewBox={viewBox} fill="currentColor" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}><path d={d} /></svg>
